      "css": ".ds-dialog{position:relative;width:min(480px,calc(100% - 32px));box-sizing:border-box;background:var(--color-surface);color:var(--color-text);border-radius:16px;padding:24px;box-shadow:0 18px 60px rgba(0,0,0,.35);display:grid;gap:14px;font-family:var(--font-sans)}.ds-dialog h2,.ds-dialog p{margin:0}.ds-dialog p{color:var(--color-muted)}.ds-dialog-close{position:absolute;right:14px;top:14px;width:40px;height:40px;border:1px solid var(--color-border);border-radius:10px;background:var(--color-surface);color:var(--color-text);cursor:pointer;font-size:20px}.ds-dialog-close:hover{background:var(--color-surface-2)}.ds-dialog-close:focus-visible{outline:2px solid var(--color-accent-strong);outline-offset:3px}"
