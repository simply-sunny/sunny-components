      "html": "<button class=\"ds-btn ds-btn-primary\">Copy source</button>",
      "css": ".ds-btn{min-height:40px;border:1px solid transparent;border-radius:10px;padding:0 16px;display:inline-flex;gap:8px;align-items:center;justify-content:center;font-family:var(--font-sans);font-weight:620;cursor:pointer;transition:background-color .18s,color .18s,border-color .18s,transform .18s cubic-bezier(.2,.8,.2,1)}.ds-btn-primary{background:var(--color-accent);color:var(--color-accent-ink)}.ds-btn:hover{transform:translateY(-1px)}.ds-btn:active{transform:none}.ds-btn:focus-visible{outline:2px solid var(--color-accent-strong);outline-offset:3px}.ds-btn:disabled{opacity:.48;cursor:not-allowed;transform:none}"
    },
