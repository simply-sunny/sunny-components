      "css": ".ds-card{display:grid;gap:8px;border:1px solid var(--color-border);border-radius:14px;background:var(--color-surface);color:var(--color-text);padding:20px;font-family:var(--font-sans);transition:border-color .18s}.ds-card:hover{border-color:var(--color-border-strong)}.ds-card>span,.ds-card>small{color:var(--color-muted)}.ds-card>strong{font-size:2rem;letter-spacing:-.03em;font-variant-numeric:tabular-nums}"
